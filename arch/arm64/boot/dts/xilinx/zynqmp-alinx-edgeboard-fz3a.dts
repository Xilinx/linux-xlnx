// SPDX-License-Identifier: GPL-2.0
/*
 * Device tree for the ALINX EdgeBoard FZ3A
 * based on the Xilinx Zynq UltraScale+ XCZU3EG
 *
 * Product info: https://ai.baidu.com/tech/hardware/deepkit
 * Documentation: https://ai.baidu.com/ai-doc/HWCE/8kq9b2121
 *
 * Copyright (c) 2026 Pufan Jin
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/pinctrl-zynqmp.h>
#include "zynqmp.dtsi"
#include "zynqmp-clk-ccf.dtsi"

/ {
	compatible = "alinx,edgeboard-fz3a", "xlnx,zynqmp";
	model = "ALINX EdgeBoard FZ3A";

	aliases {
		ethernet0 = &gem3;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
		serial0 = &uart1;
		serial1 = &uart0;
		spi0 = &qspi;
		usb0 = &usb0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	dp_aclk: clock-dp-aclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	gtr_refclk0: clock-gtr-ref0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	gtr_refclk1: clock-gtr-ref1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
	};

	gtr_refclk2: clock-gtr-ref2 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <27000000>;
	};

	/*
	 * Vendor TF-A 1.8.1 does not register LPD_LSBUS (ID 31) into CCF.
	 * Provide a fixed-clock fallback for bus peripherals to probe.
	 */
	lpd_lsbus: clock-lpd-lsbus {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	dpcon: connector {
		compatible = "dp-connector";
		label = "mini-DP";
		type = "mini";

		port {
			dpcon_in: endpoint {
				remote-endpoint = <&dpsub_dp_out>;
			};
		};
	};

	vcc_3v3_pcie: regulator-pcie {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&gpio 37 GPIO_ACTIVE_HIGH>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "pcie-reset";
	};

	reserved_memory: reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;

		linux_cma: cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x0 0x0 0x0 0x7ff00000>;
			reusable;
			size = <0x0 0x20000000>;
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x7ff00000>;
	};
};

&ams_pl {
	status = "okay";
};

&ams_ps {
	status = "okay";
};

&dwc3_0 {
	dr_mode = "host";
	maximum-speed = "super-speed";
	snps,dis_enblslpm_quirk;
	snps,dis_u2_susphy_quirk;
	snps,hsphy_interface = "ulpi";
	snps,usb3_lpm_capable;

	status = "okay";
};

&gem3 {
	clocks = <&lpd_lsbus>, <&zynqmp_clk GEM3_REF>,
		 <&zynqmp_clk GEM3_TX>, <&zynqmp_clk GEM3_RX>,
		 <&zynqmp_clk GEM_TSU>;
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	pinctrl-0 = <&pinctrl_gem3_default>;
	pinctrl-names = "default";

	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		phy0: ethernet-phy@1 {
			compatible = "ethernet-phy-id0022.1620";
			reg = <1>;
		};
	};
};

&gpio {
	clocks = <&lpd_lsbus>;

	status = "okay";
};

&i2c0 {
	clock-frequency = <400000>;
	pinctrl-0 = <&pinctrl_i2c0_default>;
	pinctrl-names = "default";

	status = "okay";
};

&i2c1 {
	clock-frequency = <400000>;
	pinctrl-0 = <&pinctrl_i2c1_default>;
	pinctrl-names = "default";

	status = "okay";
};

&out_dp {
	dpsub_dp_out: endpoint {
		remote-endpoint = <&dpcon_in>;
	};
};

&pcie {
	phys = <&psgtr 0 PHY_TYPE_PCIE 0 0>;

	status = "okay";
};

&pinctrl0 {
	status = "okay";

	pinctrl_gem3_default: gem3-default {
		conf {
			groups = "ethernet3_0_grp";
			slew-rate = <SLEW_RATE_SLOW>;
		};

		conf-mdio {
			bias-disable;
			groups = "mdio3_0_grp";
			slew-rate = <SLEW_RATE_SLOW>;
		};

		conf-rx {
			low-power-disable;
			pins = "MIO70", "MIO71", "MIO72", "MIO73", "MIO74",
			       "MIO75";
		};

		conf-tx {
			bias-disable;
			low-power-enable;
			pins = "MIO64", "MIO65", "MIO66", "MIO67", "MIO68",
			       "MIO69";
		};

		mux {
			function = "ethernet3";
			groups = "ethernet3_0_grp";
		};

		mux-mdio {
			function = "mdio3";
			groups = "mdio3_0_grp";
		};
	};

	pinctrl_i2c0_default: i2c0-default {
		conf {
			bias-pull-up;
			groups = "i2c0_8_grp";
		};

		mux {
			function = "i2c0";
			groups = "i2c0_8_grp";
		};
	};

	pinctrl_i2c1_default: i2c1-default {
		conf {
			bias-pull-up;
			groups = "i2c1_8_grp";
		};

		mux {
			function = "i2c1";
			groups = "i2c1_8_grp";
		};
	};

	pinctrl_sdhci0_default: sdhci0-default {
		conf {
			bias-disable;
			groups = "sdio0_0_grp";
			slew-rate = <SLEW_RATE_SLOW>;
		};

		mux {
			function = "sdio0";
			groups = "sdio0_0_grp";
		};
	};

	pinctrl_usb0_default: usb0-default {
		mux {
			function = "usb0";
			groups = "usb0_0_grp";
		};
	};
};

&psgtr {
	clocks = <&gtr_refclk0>, <&gtr_refclk1>, <&gtr_refclk2>;
	clock-names = "ref0", "ref1", "ref2";

	status = "okay";
};

&qspi {
	clocks = <&zynqmp_clk QSPI_REF>, <&lpd_lsbus>;
	num-cs = <1>;

	status = "okay";

	flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&sdhci0 {
	assigned-clock-rates = <187498125>;
	bus-width = <8>;
	cap-mmc-hw-reset;
	clocks = <&zynqmp_clk SDIO0_REF>, <&lpd_lsbus>;
	disable-wp;
	mmc-hs200-1_8v;
	no-sd;
	no-sdio;
	non-removable;
	pinctrl-0 = <&pinctrl_sdhci0_default>;
	pinctrl-names = "default";
	xlnx,mio-bank = <0>;

	status = "okay";
};

&sdhci1 {
	clocks = <&zynqmp_clk SDIO1_REF>, <&lpd_lsbus>;
	disable-wp;
	no-1-8-v;

	status = "okay";
};

&uart0 {
	clocks = <&zynqmp_clk UART0_REF>, <&lpd_lsbus>;

	status = "okay";
};

&uart1 {
	clocks = <&zynqmp_clk UART1_REF>, <&lpd_lsbus>;

	status = "okay";
};

&usb0 {
	phys = <&psgtr 1 PHY_TYPE_USB3 0 1>;
	phy-names = "usb3-phy";
	pinctrl-0 = <&pinctrl_usb0_default>;
	pinctrl-names = "default";
	reset-gpios = <&gpio 44 GPIO_ACTIVE_LOW>;

	status = "okay";
};

&zynqmp_dpdma {
	status = "okay";
};

&zynqmp_dpsub {
	clocks = <&dp_aclk>,
		 <&zynqmp_clk DP_AUDIO_REF>,
		 <&zynqmp_clk DP_VIDEO_REF>;
	clock-names = "dp_apb_clk", "dp_aud_clk", "dp_vtc_pixel_clk_in";
	phys = <&psgtr 3 PHY_TYPE_DP 0 2>,
	       <&psgtr 2 PHY_TYPE_DP 1 2>;
	phy-names = "dp-phy0", "dp-phy1";

	status = "okay";
};
