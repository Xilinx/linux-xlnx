/dts-v1/;
#include "zynq-alinx-ac7z020.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "ALINX AX7Z020B Development Board";
	compatible = "alinx,ax7z020b", "alinx,ac7z020", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart1;
		serial1 = &uart0;
		mmc0 = &sdhci0;
		spi0 = &qspi;
		i2c0 = &i2c0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	usb_phy0: phy {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
		reset-gpios = <&gpio0 46 GPIO_ACTIVE_LOW>;
	};
};

&adc {
	xlnx,channels {
		#address-cells = <1>;
		#size-cells = <0>;

		/* AD1: XADC_AD1P/N, E17/D18 */
		channel@2 {
			reg = <2>;
		};

		/* AD9: XADC_AD9P/N, E18/E19 */
		channel@a {
			reg = <10>;
		};

		/* Spare pair: XADC_AD12P/N, F19/F20 */
		channel@d {
			reg = <13>;
		};
	};
};

&can0 {
	status = "okay";
};

&can1 {
	status = "okay";
};

&gem0 {
	phy-mode = "rgmii-id";
	phy-handle = <&ethernet_phy>;

	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet_phy: ethernet-phy@1 {
			reg = <1>;

			leds {
				#address-cells = <1>;
				#size-cells = <0>;

				led@0 {
					reg = <0>;
					color = <LED_COLOR_ID_GREEN>;
					function = LED_FUNCTION_LAN;
					default-state = "keep";
				};

				led@1 {
					reg = <1>;
					color = <LED_COLOR_ID_YELLOW>;
					function = LED_FUNCTION_ACTIVITY;
					default-state = "keep";
				};
			};
		};
	};
};

&i2c0 {
	clock-frequency = <100000>;

	status = "okay";

	temperature-sensor@48 {
		compatible = "national,lm75";
		reg = <0x48>;
	};

	eeprom@50 {
		compatible = "atmel,24c04";
		reg = <0x50>;
		pagesize = <16>;
	};

	rtc@68 {
		compatible = "dallas,ds1338";
		reg = <0x68>;
	};
};

&sdhci0 {
	bootph-all;
	disable-wp;

	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	bootph-all;

	status = "okay";
};

&usb0 {
	dr_mode = "host";
	usb-phy = <&usb_phy0>;

	status = "okay";
};
